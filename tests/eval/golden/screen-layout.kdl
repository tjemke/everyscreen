output "DP-1" {
    mode "1920x1080@60.000"
    scale 1
    transform "normal"
    position x=1080 y=412
    focus-at-startup
}
output "DP-2" {
    mode "1920x1080@60.000"
    scale 1
    transform "90"
    position x=0 y=0
}
output "HDMI-A-1" {
    mode "3840x2160@60.000"
    scale 1.500000
    transform "normal"
    position x=3000 y=300
}
